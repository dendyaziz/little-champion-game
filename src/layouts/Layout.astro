---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Little Champion - Fun Learning Game",
  description = "A playful, tactile educational game for kindergarten kids to learn numbers, letters, shapes, and colors!"
} = Astro.props;

import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#38bdf8" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Favicon & PWA Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Google Fonts: Fredoka & Baloo 2 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Fredoka:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-gradient-to-b from-sky-100 via-indigo-50 to-amber-50 min-h-screen text-slate-800 antialiased select-none touch-pan-y">
    <slot />

    <!-- PWA Service Worker Registration (Production only to avoid dev intercept) -->
    <script is:inline>
      if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
        const isLocalhost = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
        if (!isLocalhost) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch((err) => {
              console.log('ServiceWorker registration error:', err);
            });
          });
        } else {
          // Unregister any active SW in local dev so Vite/Astro loads seamlessly
          navigator.serviceWorker.getRegistrations().then((regs) => {
            for (let reg of regs) {
              reg.unregister();
            }
          });
        }
      }
    </script>
  </body>
</html>
